# Database
MONGODB_URI=mongodb://localhost:27017

# Private Captcha
NEXT_PUBLIC_PC_SITEKEY=
PC_API_KEY=

# Sendgrid
SENDGRID_API_KEY=

# Misc
ADMIN_USER_PASSWORD=openssl rand -base64 32

# Accounts (better-auth)
# Signs session cookies. Keep it stable: changing it signs everyone out.
# Without it the site still runs, but login is disabled.
BETTER_AUTH_SECRET=openssl rand -base64 32
# Public URL of the site (optional, avoids a startup warning)
BETTER_AUTH_URL=https://moggel.ch

# Hosting
PROXY_IP_HEADER=X-Forwarded-For